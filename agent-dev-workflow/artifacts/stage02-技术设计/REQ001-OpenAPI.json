          "outAftersaleId": { "type": "string" },
          "alipayAftersaleId": { "type": "string", "nullable": true },
          "outOrderId": { "type": "string" },
          "aftersaleType": { "type": "string", "enum": ["ORDER_CANCEL", "COMPENSATION"] },
          "reasonCode": { "type": "string" },
          "reasonDesc": { "type": "string", "nullable": true },
          "additionalDesc": { "type": "string", "nullable": true },
          "fileIds": { "type": "string", "nullable": true },
          "payAmount": { "type": "string", "nullable": true },
          "payStatus": { "type": "string", "enum": ["0", "1", "2"], "description": "字典D10010：0-待收取 1-已收取 2-免于收取" },
          "aftersaleStatus": { "type": "string", "enum": ["0", "1", "2"], "description": "字典D10011：0-处理中 1-已完结 2-已取消" },
          "finishTime": { "type": "string", "nullable": true },
          "createTime": { "type": "string" }
        },
        "required": ["id", "outAftersaleId", "outOrderId", "aftersaleType", "reasonCode", "payStatus", "aftersaleStatus", "createTime"]
      },
      "AftersalePageData": {
        "type": "object",
        "allOf": [{ "$ref": "#/components/schemas/PageMeta" }],
        "properties": {
          "records": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/AftersaleVO" }
          }
        },
        "required": ["records"]
      },
      "AftersaleConfirmRequest": {
        "type": "object",
        "properties": {
          "outAftersaleId": { "type": "string", "maxLength": 64 },
          "operationType": {
            "type": "string",
            "enum": ["USER_CANCEL_APPLY", "AFTERSALE_FINISH"],
            "description": "用户取消申请/售后完结"
          }
        },
        "required": ["outAftersaleId", "operationType"]
      },
      "AlipayNotifyRequest": {
        "type": "object",
        "description": "支付宝异步通知公共参数（form-urlencoded）",
        "properties": {
          "biz_content": { "type": "string", "description": "通知业务报文（JSON原文）" },
          "msg_method": { "type": "string", "maxLength": 100, "description": "消息方法名" },
          "notify_id": { "type": "string", "maxLength": 64, "description": "通知ID，幂等去重键" },
          "app_id": { "type": "string", "maxLength": 64 },
          "sign": { "type": "string" },
          "sign_type": { "type": "string", "enum": ["RSA2"] },
          "version": { "type": "string", "maxLength": 16 },
          "utc_timestamp": { "type": "string", "description": "时间戳 yyyy-MM-dd HH:mm:ss" },
          "charset": { "type": "string", "enum": ["UTF-8"] }
        },
        "required": ["biz_content", "msg_method", "notify_id", "app_id", "sign", "sign_type", "version", "utc_timestamp"]
      }
    }
  }
}
