          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/GoodsPageRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "交易成功",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/ApiResponseBase" },
                    {
                      "type": "object",
                      "properties": {
                        "data": { "$ref": "#/components/schemas/GoodsPageData" }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
