{
  "openapi": "3.0.3",
  "info": {
    "title": "汽车订阅支付宝对接 API",
    "description": "需求编号 REQ001（PRD-REQ001-汽车订阅支付宝对接）。业务领域编码 01=汽车订阅；模块编码：01-商品 02-订单 03-签约 04-风控 05-支付 07-售后 08-通知网关。金额统一为 String（元，2位小数），表主键 ID 统一为 String。除 /api/v1/callback/alipay/notify 外，响应均为统一结构 {code,message,data,success,timestamp}。",
    "version": "v1.0"
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "tags": [
    { "name": "商品模块", "description": "M1 商品与商品库" },
    { "name": "订单模块", "description": "M2 订单" },
    { "name": "签约模块", "description": "M3 签约与芝麻免押" },
    { "name": "风控模块", "description": "M4 风控审核" },
    { "name": "支付模块", "description": "M5 支付与扣款" },
    { "name": "售后模块", "description": "M7 售后" },
    { "name": "通知网关", "description": "横切：支付宝异步通知统一接收" }
  ],
  "paths": {
    "/rent/goods/page": {
