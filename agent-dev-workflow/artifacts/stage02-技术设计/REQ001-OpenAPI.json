        }
      }
    },
    "/callback/alipay/notify": {
      "post": {
        "tags": ["通知网关"],
        "summary": "A0108001 支付宝异步通知接收",
        "description": "统一接收支付宝异步通知（冻结/支付/售后/订单变更），验签+notify_id幂等+落库分发。响应遵循支付宝协议返回文本 success，不适用统一 JSON 响应结构。",
        "operationId": "receiveAlipayNotify",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": { "$ref": "#/components/schemas/AlipayNotifyRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "处理成功返回文本 success",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string",
                  "enum": ["success", "fail"]
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "responses": {
      "EmptyDataResponse": {
        "description": "交易成功（data为空）",
        "content": {
          "application/json": {
            "schema": {
              "allOf": [
                { "$ref": "#/components/schemas/ApiResponseBase" },
                {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "nullable": true
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "schemas": {
      "ApiResponseBase": {
        "type": "object",
        "description": "统一响应外层结构",
        "properties": {
          "code": {
            "type": "string",
            "description": "响应码，成功为SY000000",
            "example": "SY000000"
          },
          "message": {
            "type": "string",
            "description": "响应信息",
            "example": "交易成功"
          },
          "success": {
            "type": "boolean",
            "description": "是否成功"
          },
          "timestamp": {
            "type": "string",
            "description": "响应时间戳（毫秒）",
            "example": "1772775292343"
          }
        },
        "required": ["code", "message", "success", "timestamp"]
      },
      "PageParam": {
        "type": "object",
        "properties": {
          "pageNo": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "description": "页码"
          },
          "pageSize": {
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 100,
            "description": "每页条数"
          }
        },
        "required": ["pageNo", "pageSize"]
      },
      "PageMeta": {
        "type": "object",
        "properties": {
          "total": {
            "type": "integer",
            "format": "int64",
            "description": "总条数"
          },
          "current": {
            "type": "integer",
            "format": "int64",
            "description": "当前页码"
          },
          "size": {
            "type": "integer",
            "format": "int64",
            "description": "每页条数"
          },
          "pages": {
            "type": "integer",
            "format": "int64",
            "description": "总页数"
          }
        },
        "required": ["total", "current", "size", "pages"]
      },
      "GoodsPageRequest": {
        "type": "object",
        "allOf": [{ "$ref": "#/components/schemas/PageParam" }],
        "properties": {
          "params": {
            "type": "object",
            "description": "查询条件",
            "properties": {
              "goodsName": {
                "type": "string",
                "maxLength": 200,
                "description": "商品名称，模糊匹配"
              },
              "goodsStatus": {
                "type": "string",
                "enum": ["0", "1"],
                "description": "字典D10013：0-下架 1-上架"
              },
              "reportStatus": {
                "type": "string",
                "enum": ["0", "1", "2", "3"],
                "description": "字典D10012：0-未提报 1-提报中 2-已提报 3-提报失败"
              }
            }
          }
        },
        "required": ["params"]
      },
      "GoodsSkuVO": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "description": "SKU ID（雪花ID）" },
          "outSkuId": { "type": "string", "description": "支付宝商品库SKU ID" },
          "skuName": { "type": "string", "description": "SKU名称（订阅套餐描述）" },
          "durationDays": { "type": "integer", "format": "int32", "description": "租期时长（天）" },
          "salePrice": { "type": "string", "description": "SKU售价（元，2位小数）" },
          "skuStatus": { "type": "string", "enum": ["0", "1"], "description": "字典D10013：0-下架 1-上架" }
        },
        "required": ["id", "skuName", "durationDays", "salePrice", "skuStatus"]
      },
      "GoodsVO": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "description": "商品ID（雪花ID）" },
          "goodsCode": { "type": "string", "maxLength": 64, "description": "商品编码" },
          "goodsName": { "type": "string", "maxLength": 200, "description": "商品名称" },
          "outItemId": { "type": "string", "description": "支付宝商品库商品ID，未提报为空" },
          "salePrice": { "type": "string", "description": "商品售价（元，2位小数）" },
          "itemValue": { "type": "string", "description": "商品价值（元，2位小数）" },
          "durationDays": { "type": "integer", "format": "int32", "description": "标准租期（天）" },
          "reportStatus": { "type": "string", "enum": ["0", "1", "2", "3"], "description": "字典D10012 提报状态" },
          "goodsStatus": { "type": "string", "enum": ["0", "1"], "description": "字典D10013 商品状态" },
          "skuList": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/GoodsSkuVO" }
          }
        },
        "required": ["id", "goodsCode", "goodsName", "salePrice", "reportStatus", "goodsStatus", "skuList"]
      },
      "GoodsPageData": {
        "type": "object",
        "allOf": [{ "$ref": "#/components/schemas/PageMeta" }],
        "properties": {
          "records": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/GoodsVO" }
          }
        },
        "required": ["records"]
      },
      "RentPlanInstallment": {
        "type": "object",
        "properties": {
          "installmentNo": { "type": "integer", "format": "int32", "minimum": 1, "description": "期号，从1递增" },
          "installmentPrice": { "type": "string", "description": "当期订阅金额（元，2位小数），除首尾期外金额需一致" },
          "planPayTime": { "type": "string", "description": "计划扣款时间 yyyy-MM-dd HH:mm:ss" },
          "buyoutPrice": { "type": "string", "description": "到期购买金额，仅最后一期传入" }
        },
        "required": ["installmentNo", "installmentPrice", "planPayTime"]
      },
      "RentPlanInfo": {
        "type": "object",
        "properties": {
          "rentStartTime": { "type": "string", "description": "租赁开始时间 yyyy-MM-dd HH:mm:ss" },
          "rentEndTime": { "type": "string", "description": "租赁结束时间 yyyy-MM-dd HH:mm:ss" },
          "installments": {
            "type": "array",
            "maxItems": 36,
            "items": { "$ref": "#/components/schemas/RentPlanInstallment" }
          }
        },
        "required": ["rentStartTime", "rentEndTime", "installments"]
      },
      "ShopInfo": {
        "type": "object",
        "properties": {
          "shopName": { "type": "string", "maxLength": 100, "description": "门店名称" },
          "shopAddress": { "type": "string", "maxLength": 300, "description": "门店地址" },
          "shopTel": { "type": "string", "description": "门店电话" }
        }
      },
      "ReceiverInfo": {
        "type": "object",
        "properties": {
          "receiverName": { "type": "string", "maxLength": 64, "description": "收货人姓名" },
          "receiverTel": { "type": "string", "description": "收货人电话" },
          "detailedAddress": { "type": "string", "maxLength": 300, "description": "详细地址" }
        }
      },
      "OrderCreateRequest": {
